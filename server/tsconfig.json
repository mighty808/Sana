{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"],
  // Test files are checked separately, via tsconfig.test.json — they use
  // Jest's ambient globals (describe/test/expect), which this config
  // deliberately doesn't declare, and they must never end up compiled into
  // dist/ as part of the production build.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
