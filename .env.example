# Copy the relevant block into server/.env, ai-service/.env, and client/.env
# respectively. None of these files are committed — see .gitignore.

# --- server/.env ---
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/sana
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent to the AI service as the X-Sana-Token header. Must match
# AI_SERVICE_TOKEN in ai-service/.env below. Leave both blank for local
# development and the endpoint stays open; set both before exposing the AI
# service beyond localhost. Setting only one side fails closed (401).
AI_SERVICE_TOKEN=

# --- ai-service/.env ---
# Get a free key at console.groq.com. Without it the service starts but
# /v1/consult returns 503 and /health reports unavailable.
GROQ_API_KEY=
# Optional. Overrides the default chat model without a code change.
# GROQ_MODEL=openai/gpt-oss-120b
# The other half of the shared secret above — the two must be identical.
AI_SERVICE_TOKEN=

# --- client/.env ---
# Leave both unset for local development — the client then assumes it shares
# an origin with the server (via vite.config.ts's dev proxy, or being served
# by the same host in production), exactly as before these existed. Set both
# only when client and server are deployed to different origins (e.g. client
# on Vercel, server on Render — see README.md's "Deployment" section).
# VITE_API_URL=https://sana-server-xxxx.onrender.com/api/v1
# VITE_SOCKET_URL=https://sana-server-xxxx.onrender.com
